# Bilibili account credentials. Do not commit real values.
cookie_value=your_sessdata
bili_jct=your_bili_jct

# Application settings
DB_HOST=bili-db
my_user_id=your_bilibili_uid
max_checks=20
home_url=https://space.bilibili.com/your_bilibili_uid/dynamic
ignore_link=
multi_users=
do_type=1
is_remove=false
remove_cnt=0
share_content=
comment_content=
ups=
notify_switch=false
FangTang_KEY=

# MySQL settings
TZ=Asia/Shanghai
PORT=3306
MYSQL_DATABASE=luckybili
MYSQL_USER=luckybili
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# Selenium and scheduler settings
selenium_url=http://bili-selenium:4444/wd/hub
DRIVER_VERSION=Online
SCHEDULE_INTERVAL_HOURS=3
CLEANUP_INTERVAL_HOURS=24
CLEANUP_ENABLED=false
CLEANUP_DRY_RUN=true
UNFOLLOW_ENABLED=false
SHARE_BATCH_LIMIT=0
SHARE_BROWSER_RECYCLE_EVERY=20
SHARE_RESTART_ERROR_LIMIT=3
SELENIUM_HOST=bili-selenium
SELENIUM_PORT=4444
SELENIUM_PATH=/wd/hub
SELENIUM_PAGE_LOAD_TIMEOUT=60
SCAN_CACHE_RETRY_HOURS=24
AUTO_RUN_ON_START=true
